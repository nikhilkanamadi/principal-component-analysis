# Copy to .env and fill in values before running docker-compose

# PostgreSQL
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather123
POSTGRES_DB=weather_anomaly
DATABASE_URL=postgresql://weather:weather123@postgres:5432/weather_anomaly

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=raw-weather
KAFKA_TOPIC_PROCESSED=processed-weather
KAFKA_CONSUMER_GROUP=weather-consumer

# Spark
SPARK_MASTER=spark://spark-master:7077
PG_JDBC_URL=jdbc:postgresql://postgres:5432/weather_anomaly

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=weather-anomaly-detection

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://weather:weather123@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
